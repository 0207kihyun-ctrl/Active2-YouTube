<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://0207kihyun-ctrl.github.io/active2-youtube"
        version="0.1.0"
        viewmodes="maximized">
  <tizen:application id="A2YT00001.Active2YouTube"
                     package="A2YT00001"
                     required_version="4.0"/>
  <tizen:profile name="wearable"/>
  <content src="index.html"/>
  <name>Active2 YouTube Test</name>
  <description>16:9 YouTube playback and pinch zoom test for Galaxy Watch Active2.</description>
  <feature name="http://tizen.org/feature/screen.size.normal"/>
  <feature name="http://tizen.org/feature/input.touch"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <access origin="https://www.youtube.com" subdomains="true"/>
  <access origin="https://www.youtube-nocookie.com" subdomains="true"/>
  <access origin="https://www.google.com" subdomains="true"/>
</widget>
